{
  "manifest_version": 3,
  "name": "Green AI Monitor",
  "version": "1.0.0",
  "description": "Estima o impacto ambiental associado ao uso de IA e à navegação na Web.",
  "permissions": [
    "tabs",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Green AI Monitor"
  },
  "background": {
    "service_worker": "background.js"
  }
}