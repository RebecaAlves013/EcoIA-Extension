{
    "manifest_version": 3,
    "name": "Green AI Monitor",
    "version": "1.0.0",
    "description": "Estimativa do consumo de energia e água associado ao uso de ferramentas de inteligência artificial e navegação web.",

    "permissions": [
        "storage",
        "tabs"
    ],

    "host_permissions": [
        "<all_urls>"
    ],

    "background": {
        "service_worker": "src/background/background.js"
    },

    "action": {
        "default_popup": "src/popup/popup.html",
        "default_title": "Green AI Monitor"
    },

    "content_scripts": [
        {
            "matches": [
                "<all_urls>"
            ],
            "js": [
                "src/content/content.js"
            ]
        }
    ],

    "web_accessible_resources": [
        {
            "resources": [
                "data/parameters.json"
            ],
            "matches": [
                "<all_urls>"
            ]
        }
    ]
}